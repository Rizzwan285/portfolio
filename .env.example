# Optional settings. Copy this file to `.env` and fill in what you need.
# Nothing here is required: without a .env file the site builds and runs as-is.

# Public URL of the deployed site, without a trailing slash.
# When set, the build adds canonical + Open Graph image tags so links shared
# on LinkedIn, WhatsApp, X, etc. show the preview card (public/og-image.jpg).
# VITE_SITE_URL=https://your-domain.com

# Sub-path the site is served from. Leave unset for a domain root
# (Vercel, Netlify, https://<user>.github.io). For a GitHub Pages *project*
# site served at https://<user>.github.io/<repo>/, set it to "/<repo>/".
# The included GitHub Actions workflow sets this for you.
# VITE_BASE=/rizwan-portfolio/
